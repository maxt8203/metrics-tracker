# Copy to .env and fill in. Never commit .env.

# Oura OAuth app (cloud.ouraring.com/oauth/applications)
OURA_CLIENT_ID=
OURA_CLIENT_SECRET=
OURA_REDIRECT_URI=http://localhost:8080/callback

# Google Cloud OAuth client (type: Desktop app). Path to the downloaded JSON.
GOOGLE_CLIENT_SECRET_FILE=client_secret.json
# Calendars to read (comma-separated IDs). Default: primary.
# Only include calendars of things you choose to do. Leave out fixed commitments
# (work, timetabled classes, recurring appointments, bills): they appear every
# week regardless, so they add noise, and unmatched titles are sent to the AI classifier.
GCAL_CALENDAR_IDS=primary
# Optional: dedicated calendar whose events always count as "social" (read automatically)
GCAL_SOCIAL_CALENDAR_ID=
# Optional: work calendar, read for the time split only (titles are never sent to the AI and
# never count towards variety). Without it, work time shows as "not tracked".
GCAL_WORK_CALENDAR_ID=

# Anthropic
ANTHROPIC_API_KEY=
REVIEW_MODEL=claude-sonnet-5-5
CLASSIFIER_MODEL=claude-haiku-5-5
EVAL_MODEL=claude-haiku-5-5

# Local storage backend (sprint). Azure Tables comes later.
TRACKER_STORE=json
TRACKER_DATA_DIR=data
